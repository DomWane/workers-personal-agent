{
  "name": "personal-agent",
  "version": "0.1.0",
  "description": "A personal AI agent on Cloudflare Workers: web chat, long-term memory in R2, deep research fanned out across Durable Objects",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "build": "pnpm build:web",
    "build:web": "vite build web",
    "check:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test web/src scripts",
    "format": "oxfmt src test web/src scripts",
    "format:check": "oxfmt --check src test web/src scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "agents": "^0.16.2",
    "openai": "^6.49.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@lucide/vue": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "~2.3.0",
    "nanoid": "^6.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reka-ui": "^2.10.4",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "~3.2.7",
    "vue": "^3.5.42",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.0.4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.131.2"
  }
}
