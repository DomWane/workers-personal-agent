{
  "name": "personal-agent",
  "version": "0.1.0",
  "description": "A personal AI agent on Cloudflare Workers: web chat, long-term memory in R2, deep research fanned out across Durable Objects",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite web",
    "build": "pnpm build:web",
    "build:web": "vite build web",
    "check:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test web/src evals scripts",
    "format": "oxfmt src test web/src evals scripts",
    "format:check": "oxfmt --check src test web/src evals scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:evals": "tsc --noEmit -p evals/tsconfig.json",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "eval:traces": "node --env-file-if-exists=.env evals/ingest/traces.ts",
    "eval:turns": "node evals/turn-table.ts",
    "eval:retrieval": "node evals/run-retrieval.ts",
    "eval:gen": "node evals/gen/queries.ts",
    "eval:label": "node evals/label/retrieval.ts",
    "eval:embed": "node evals/embed/precompute.ts",
    "eval:prescreen": "node evals/label/prescreen.ts",
    "eval:hard": "node evals/label/hard.ts",
    "eval:pool": "node evals/label/pool.ts",
    "eval:rerank": "node --env-file-if-exists=.env evals/embed/rerank-precompute.ts",
    "eval:models": "node --env-file-if-exists=.env evals/models/compare.ts",
    "eval:models:analyze": "node --env-file-if-exists=.env evals/models/analyze.ts",
    "eval:models:judge": "node evals/models/judge.ts",
    "eval:models:llm-judge": "node --env-file-if-exists=.env evals/models/llm-judge.ts",
    "eval:models:agreement": "node --env-file-if-exists=.env evals/models/judge-agreement.ts"
  },
  "dependencies": {
    "agents": "^0.16.0",
    "openai": "^6.42.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.13",
    "@cloudflare/workers-types": "^4.20260620.0",
    "@lucide/vue": "^1.31.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion-v": "^2.3.0",
    "nanoid": "^6.0.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "reka-ui": "^2.10.3",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "~3.2.4",
    "vue": "^3.5.41",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^1.0.4",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.59.3"
  }
}
