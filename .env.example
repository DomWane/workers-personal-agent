# Secrets only. wrangler dev and the eval:* scripts read .env; the Deploy to Cloudflare button reads
# this file and asks for every key as a production secret, so vars such as ENVIRONMENT=localhost go
# into your local .env by hand, never here.

# Only when LLM_BASE_URL in wrangler.jsonc points somewhere other than Cloudflare. The committed
# value is OpenRouter; delete it and Workers AI answers with CF_API_TOKEN alone.
LLM_API_KEY=sk-or-...
CF_ACCOUNT_ID=...
# Workers AI: Read, Browser Rendering: Edit, Billing: Read (+ Account Analytics: Read for eval:traces)
CF_API_TOKEN=...
# Both optional: search runs keyless on either vendor, a key only raises its rate limit. Tavily leads
# the chain; Firecrawl is the second vendor and the read_page fallback when Browser Rendering refuses.
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
